finnishpolkatitle = "Finnish Polka"
finnishpolkasourcetext = ""
finnishpolkamelody = \relative c'' {
  \clef treble
  \key d \major
  \time 2/4
  \repeat volta 2 {
    b8. b16 b8 cis |
    d b b d |
    cis a a cis |
    d16 cis b a b8 fis |
    b8. b16 b8 cis |
    d8 b b4 |
    e8 fis16 e d8 cis |
    b4 b |
  }
  \repeat volta 2 {
    fis'8. d16 d8 fis |
    e cis cis d |
    e fis16 e d8 cis |
    b8 cis d e |
    fis8. d16 d8 fis |
    e8 cis cis d |
    e8 fis16 e d8 cis |
    b4 b |
  }
}
finnishpolkachords = \chordmode {
  \repeat volta 2 {
    b2:m |
    b:m |
    a |
    b:m |
    b:m |
    b:m |
    a |
    b:m |
  }
  \repeat volta 2 {
    d |
    a:7 |
    e:m |
    b:m |
    d: |
    a:7 |
    a4 d4:7 |
    b2:m |
  }
}

