chevalasagnetitle = "Le Chevalasagne de Findus"
chevalasagnesourcetext = ""
chevalasagnemelody = \relative c'' {
  \clef treble
  \key a \major
  \time 4/4
  \repeat volta 2 {
    a8 b cis d e4 a4 |
    gis a e2 |
    fis4 d e cis |
    d8 cis b a gis a b gis |
    a8 b cis d e4 a4 |
    gis a e2 |
    fis8 e d cis d cis b a |
    gis a b gis a2 |    
    }
  \repeat volta 2 {
    e8 a a a a4 a8 a |
    cis 4 a cis e |
    e,8 gis gis gis gis4 gis8 gis |
    b4 gis b d |
    cis8 a b cis d4 d8 e |
    fis4 d fis a |
    a8 fis e d e d cis b |
    gis a b gis a2 |
    }
  }
chevalasagnechords = \chordmode {
  \repeat volta 2 {    
    a1 |
    a |
    d2 a |
    e1 |
    a1 |
    a |
    d2 a |
    e2 a |
    
    }
  \repeat volta 2 {    
    a1 |
    a1 |
    e1 |
    e1 |
    a2 d |
    d1 |
    d2 a |
    e a |
        
  }   
}

