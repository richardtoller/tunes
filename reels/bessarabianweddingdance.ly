bessarabianweddingdancetitle = "Bessarabian Wedding Dance"
bessarabianweddingdancesourcetext = ""
bessarabianweddingdancemelody = \relative c'' {
  \clef treble
  \key g \major
  \time 4/4
  \repeat volta 2 {
    bes'8 a g fis g4 g8 g |
    fis4 g ees fis |
    ees8 d c b c4 c8 c |  
    b4 c a2 |
    ees'8 d c b c4 c8 c |  
    b4 c a2 |
    a4. g8 fis4 g |
    a b c d |
  }
  \repeat volta 2 {
    b8 b4 c2 b8 |  
    b8 b b4 a2 |
    b8 b4 c2 b8 |  
    b8 b b4 a2 |
    b8 b4 c2 r8 |  
    b8 b4 c2 r8 |  
    a4 g fis g |
    a b c d |
  }
}
bessarabianweddingdancechords = \chordmode {
  \repeat volta 2 {    
    c1:m |
    c1:m |
    c1:m |
    c2:m d |
    c1:m |
    c2:m d |
    c1:m |
    c1:m |
    }
  \repeat volta 2 {    
    g2: c |
    g d |
    g2: c |
    g d |
    g2: c |
    g2: c |
    d1 |
    d1 |
    }
  }

