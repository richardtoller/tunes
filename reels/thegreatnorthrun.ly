thegreatnorthruntitle = "The Great North Run"
thegreatnorthrunsourcetext = "Robert Whitehead"
thegreatnorthrunmelody = \relative c'' {
  \clef treble
  \key g \major
  \time 4/4
  \repeat volta 2 {
    g4 g fis8 g a fis |
    g a b c d4 b |
    e c8 e d b g4 |
    a8 b a g e4 d |
    g4 g fis8 g a fis |
    g a b c d4 b |
    e c8 e d b g4 |
    a fis g2 |
  }
  \repeat volta 2 {
    g'4 e8 g fis4 d |
    e c8 e d2 |
    e4 c8 e d b g4 |
    a8 b a g e4 d |
    g4 g fis8 g a fis |
    g a b c d4 b |
    e c8 e d b  g4 |
    a fis g2 |
  }
}

thegreatnorthrunchords = \chordmode {
  \repeat volta 2 {
  g2 d |
  g1 |
  c2 g |
  d:7 d |
  g d |
  g1 |
  c2 g |
  d g |
 }
  \repeat volta 2 {
    e2:m b:m |
    c g |
    c g |
    d1:7 |
    g2 d |
    g1 |
    c2 g |
    d g
  }

}

