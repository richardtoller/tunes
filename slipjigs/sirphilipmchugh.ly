sirphilipmchughtitle = "Sir Philip McHugh"
sirphilipmchughnotes = "guitar: low"
sirphilipmchughsourcetext = ""
sirphilipmchughmelody = \relative c'' {
  \clef treble
  \key d \major
  \time 9/8
  \repeat volta 2 {
    d4 fis8 fis a fis g4 e8 |
    fis4 d8 g e d cis4 a8 |
    d4 fis8 fis a fis g4 e8 |
    fis4 d8 g e cis d4. |
  }
  \repeat volta 2 {
  e8 fis e e cis a cis b a |
  e' fis e e cis a b4. |
  e8 fis e e cis a cis b a |
  fis' a fis g e cis d4. |  
  }
}
sirphilipmchughchords = \chordmode {
  \repeat volta 2 {
   d2. e4.:m |
   d2. a4. |
   d2. e4.:m |
   d4. a:7 d |
  }
  \repeat volta 2 {
   e4.:m a2. |
   e4.:m a g |
   e4.:m a2. |
   d4. a:7 d |
  }
}

