dutchskipperminortitle = "Dutch Skipper - minor"
dutchskipperminorsourcetext = ""
dutchskipperminormelody = \relative c' {
  \clef treble
  \key g \major
  \time 6/8
  \repeat volta 2 {
    e8 e' e d4 b8  |
    c a a b g g  |
    e8 e' e d4 b8  |
    c b a b4. 
  }
  \repeat volta 2 {
    fis8 b b b4 b8 |
    c a a b g g |
    fis8 b b b4 b8 |
    c b a b4. 
  }
}
dutchskipperminorchords = \chordmode {
  \repeat volta 2 {
    e2.:m |
    a4.:m e:m  |
    e2.:m |
    a4.:m e:m  |
  }
  \repeat volta 2 {
    b2.:m |
    a4.:m b:m  |
    b2.:m |
    a4.:m b:m  |
  }
}

