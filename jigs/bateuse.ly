bateusetitle = "The Bateuse"
bateusesourcetext = "The Ironbridge Hornpipe (John Moore manuscripts)"
bateusenotes=""
bateusemelody = \relative c'' {
  \clef treble
  \key g \major
  \time 6/8
  \repeat volta 2 {
    \partial 8 g16 a |
    b4 b8 b a b |
    d4 cis8 c4 a8 |
    b4 b8 b c d |
    a4 a8 a a' g |
    fis4 fis8 fis8 e fis |
    g4 g8 g fis e |
    d e d c b a |
    g4 g8 g4.
  }
  \repeat volta 2 {
  b4 d8 d4 b8 |
  a4 e'8 d4 c8 |
  b4 c8 d e fis |
  g4 g8 g fis g |
  b4 a8 a4 g8 |
  fis g a g fis e |
  fis g a b cis d |
  a b a g fis e |
  d4 d8 d4
  }
}
