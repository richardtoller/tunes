theoldfavouritetitle = "The Old Favourite"
theoldfavouritesourcetext = ""
theoldfavouritemelody = \relative c'' {
  \clef treble
  \key g \major
  \time 12/8
  \repeat volta 2 {
    b4. b8 a b d b a g4 b8 |
    d8 e d d4 b8 d8 e d b4 a8 |
    b4. b8 a b d b a g4 b8 |
    d8 e d c b a g4. g4. |    
    }
  \repeat volta 2 {
    g'4. fis e8 g e e d b |
    d e d d4 b8 d e d d e fis |
    g4. fis e8 g e e d b |
    d g e d b a g4. g4. |
    }
  }
theoldfavouritechords = \chordmode {
  \repeat volta 2 {
    g1. |
    g2. d2. |
    g1. |
    d2.:7 g2. |
  }
  \repeat volta 2 {
  g4. d e2.:m |
  d2. b:m |
  g4. d e2.:m |
  g4. d g2. |  
  }
}

