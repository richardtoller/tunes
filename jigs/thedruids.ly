thedruidsmelody = \relative c'' {
  \clef treble
  \key d \major
  \time 6/8
  \repeat volta 2 {
    fis,8. g16 a8 a fis a |
    b g b a4. |
    b8 cis d e fis g |
    fis e d cis b a |
    fis8. g16 a8 a fis a |
    b g b a4. |
    b8 cis d e fis g |
    a fis cis d4. |
    }
  \repeat volta 2 {
    a'8 fis a a fis a |
    g e g g e g |
    fis a fis fis e d |
    cis e d cis b a |
    a' fis a a fis a |
    g e g g e g |
    fis g a g, b cis |
    d a fis d4.
    }
  }
thedruidschords = \chordmode {
 \repeat volta 2 {
   d2. |
   g4. d |
   g a |
   g a |
   d2. |
   g4. d |
   g a |
   d2.
 }
 \repeat volta 2 {
   d2. |
   a |
   d |
