    b4 a8 g b c |
    d4 d8 e4 d8 |
    b4 b8 d4 b8 |
    a4 a8 a g a |
    g4. \partial 4 g4 |
    }
  \repeat volta 2 {
    \partial 8 g'8 |
    fis8 e d d e fis |
    g4. d4 b8 |
    c8 e c b d b |
    a4 a8 a4 g'8 |
    fis e d d e fis |
    g4. e4 g8 |
    }    
    \alternative { 
      {   
      a8 b a g fis e |
      d4. (d4) g8 |
      }
      {
      fis8 a g fis e fis|
      g4. ( \partial 4 g4)  |
      }
    }
