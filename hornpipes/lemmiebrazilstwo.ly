    d8 [e] fis d \times 2/3{b cis b } a8 g |
    fis [a] d [a] b [cis] d [fis] |
    \partial 2. e4 e d |        
    }
  \repeat volta 2 {
    \partial 4 fis8 g |
    a8 [fis] d [fis] a [fis] d [fis] |
    d [e] fis [d] \times 2/3{b cis b } a g |
    fis [a] d [a] b [cis] d [fis] |
    e4 e e fis8 g |
    a8 [fis] d [fis] a [fis] d [fis] |
    d [e] fis [d] \times 2/3{b cis b } a g |
    fis [a] d [a] b [cis] d [fis] |
