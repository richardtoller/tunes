trustydickgtitle = "Trusty Dick (or The King Shall Enjoy His Own)"
trustydickgnotes = ""
trustydickgsourcetext = "(based on) Johnson mss, Vol 1, London, 1760s (original A music only four bars long)"
trustydickgmelody = \relative c' {
  \clef treble
  \key g \major
  \time 4/4
  \repeat volta 2 {
    d4 d g g | 
    a8 b c a b4 a8 b |
    c4 e, fis g8 a |
    a4. g8 g4 g8 e  |
    d4 d g g | 
    a8 b c a b4 a8 b |
    c8 b a g fis g a b |
    a4. g8 g2  |

  }
   \repeat volta 2 {
     a8 g fis g a4. b8 |
     a8 g fis g a4. b8 |
     c4 e, fis8 a g fis |
     e4. d8 d4 b'8 c |
     d e d c b4 a8 g |
     a8 b c a b4 a8 b |
     c4 e, fis g8 a |
     a4. g8 g2 |

   }
  }
trustydickgchords = \chordmode {
  \repeat volta 2 {
    g1 |
    d2:7 g |
    c1 |
    d2 g |
    g1 |
    d2:7 g |
    c1 |
    d2:7 g 
  }
  \repeat volta 2 {
    d1 |
    d |
    c2 d |
    c d:7 |
    g1 |
    d2:7 g |
    c d |
    d g
  }

}

