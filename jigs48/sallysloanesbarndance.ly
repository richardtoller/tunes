sallysloanesbarndancetitle = "Sally Sloane's Barn Dance"
sallysloanesbarndancesourcetext = ""
sallysloanesbarndancenotes = ""
sallysloanesbarndancemelody = \relative c'' {
  \clef treble
  \key d \major
  \time 6/8
  \repeat volta 2 {
  \partial 8 a8 |
  fis a d fis, a d |
  g, b d g, b d |
  fis, a d d cis d |
  fis4 e8 e4 a,8 |
  fis a d fis, a d |
  g, b d g, b d |
  fis, a d d cis d |
  e4 cis8 d4 
  }
  \repeat volta 2 {
  \partial 8 e8 |
  fis4. d8 e fis  |
  fis4 e8 e4 fis8 |
  g4 e8 cis8 d e |
  e fis e d4 e8 |
  fis4. d8 e fis |
  fis4 e8 e4 fis8 |
  g4 e8 cis8 d e |
  e fis e d4. 
  }
  \repeat volta 2 {
  a4. fis4 g8 |
  a4. fis4 g8 |
  a8 fis a d a d |
  fis e d cis b a |
  g4. e4 fis8 |
  g4. e4 fis8 |
  g b a g fis e |
  \alternative {{fis4. g}{d4. d}}
  \bar "|."
  }
}
